{
    "name": "metsa-portal-backend",
    "version": "1.0.0",
    "description": "Backend API for MetSA Portal 2025-26",
    "main": "src/server.js",
    "type": "commonjs",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:studio": "prisma studio",
        "prisma:seed": "node prisma/seed.js",
        "db:setup": "prisma generate && prisma migrate dev && node prisma/seed.js",
        "db:reset": "prisma migrate reset --force && node prisma/seed.js"
    },
    "keywords": [
        "metsa",
        "portal",
        "express",
        "prisma",
        "sqlite"
    ],
    "author": "MetSA Team",
    "license": "MIT",
    "dependencies": {
        "@prisma/client": "^5.19.0",
        "bcrypt": "^5.1.1",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "csv-parser": "^3.2.0",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "multer": "^2.0.2"
    },
    "devDependencies": {
        "nodemon": "^3.1.4",
        "prisma": "^5.19.0"
    }
}