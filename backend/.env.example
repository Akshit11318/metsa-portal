# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
PORT=5000

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL="file:./dev.db"

# ============================================
# JWT CONFIGURATION
# ============================================
# IMPORTANT: Generate a strong random secret (64+ characters)
# Generate using: openssl rand -base64 64
JWT_SECRET=your_super_secure_random_jwt_secret_here_CHANGE_THIS_IN_PRODUCTION

# JWT expiration time (default: 7 days)
JWT_EXPIRES_IN=7d

# ============================================
# CORS CONFIGURATION
# ============================================
# Set to your frontend domain in production
# Examples:
#   - For production: https://yourdomain.com
#   - For Docker: http://frontend:80
#   - For development: http://localhost:5173
CORS_ORIGIN=https://metsa.yourdomain.com

# ============================================
# CSRF PROTECTION
# ============================================
CSRF_ENABLED=true
CSRF_SECRET=your_secure_csrf_secret_CHANGE_THIS

# ============================================
# DEFAULT YEAR
# ============================================
DEFAULT_YEAR=2025

# ============================================
# UPLOAD CONFIGURATION
# ============================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
